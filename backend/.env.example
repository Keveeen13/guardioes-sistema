# Porta em que a API vai rodar
PORT=4000

# URL do seu projeto Supabase (Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave "anon" publica (Settings > API) - usada para validar sessoes de usuario
SUPABASE_ANON_KEY=coloque-a-anon-key-aqui

# Chave "service_role" (Settings > API) - NUNCA exponha no frontend
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Origem permitida para CORS (URL do frontend)
FRONTEND_URL=http://localhost:5173